---
// Shell for every page: meta tags (<Seo>), icons, fonts, masthead, main,
// footer, the toast and the command palette.
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import FontFaces from "../components/FontFaces.astro";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import Toast from "../components/Toast.astro";
import Palette from "../components/Palette.astro";

interface Props {
  title: string;
  description: string;
  /** Social image and its alt text (default: /assets/og-card.png) */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  /** Keep the page out of search results (the 404) */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** What `/` does on this page, for the footer ("search the index");
      leave it out on pages without a find field */
  findHint?: string;
}

const { findHint, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo {...seo} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <FontFaces />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Footer findHint={findHint} />
    <Toast />
    <Palette />
    <script>
      // Show ⌘ instead of Ctrl in the keyboard hints on Apple devices.
      if (/Mac|iPhone|iPad/.test(navigator.platform)) {
        document.querySelectorAll("[data-mod]").forEach((el) => (el.textContent = "⌘"));
      }
    </script>
  </body>
</html>
