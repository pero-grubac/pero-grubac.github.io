---
// Apps teaser: the number of live apps, three of them, and the
// way to the /apps/ gallery.
import { Picture } from "astro:assets";
import type { Project } from "../../lib/projects";

interface Props {
  apps: Project[];
}

const { apps } = Astro.props;
const shown = apps.filter((p) => p.image).slice(0, 3);
---

<section id="apps" aria-labelledby="apps-h">
  <div class="box">
    <div>
      <h2 id="apps-h">Browser apps</h2>
      <p class="num">{apps.length}</p>
      <p class="line">browser apps you can open right now.</p>
      <a class="lnk lnk-strong" href="/apps/">Browse the apps<span aria-hidden="true"> →</span></a>
    </div>
    <ul>
      {
        shown.map((p) => (
          <li>
            <a href={p.links.live} target="_blank" rel="noopener">
              <Picture
                src={p.image!}
                alt=""
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[320, 640]}
                sizes="(min-width: 900px) 250px, 45vw"
                loading="lazy"
                decoding="async"
              />
              {p.title}<span aria-hidden="true"> ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .box {
    display: grid;
    gap: 28px;
    padding: 28px 0;
    border-top: var(--rule-double);
    border-bottom: var(--rule-double);
  }

  @media (min-width: 900px) {
    .box {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: center;
    }
  }

  h2 {
    margin: 0 0 14px;
    font: 600 0.85rem var(--sans);
    font-variation-settings: normal;
    letter-spacing: 0;
    color: var(--muted);
  }

  .num {
    margin: 0;
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 300;
    line-height: 1;
    font-variation-settings: "opsz" 72;
  }

  .line {
    margin: 6px 0 var(--s-4);
    font-size: 1.3rem;
    font-style: italic;
  }

  .lnk {
    font: 600 0.95rem var(--sans);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 560px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    li:nth-child(3) {
      display: none;
    }
  }

  ul a {
    display: block;
    font: 500 0.85rem var(--sans);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--accent);
  }

  ul :global(img) {
    margin-bottom: var(--s-2);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top left;
    border: var(--hairline);
  }
</style>
