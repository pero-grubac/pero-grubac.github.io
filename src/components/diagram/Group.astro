---
// A container drawn in a hairline, with its name at the top left, for the
// parts of one application (the steps inside a backend). Put it before the
// nodes it holds so they are drawn on top.
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  name: string;
}

const { x, y, w, h, name } = Astro.props;
---

<g class="group">
  <rect class="shape" x={x} y={y} width={w} height={h}></rect>
  <text class="group-name" x={x + 12} y={y + 20}>{name}</text>
</g>
