---
// Self-hosted fonts from @fontsource (REDESIGN.md 6.3): latin and latin-ext
// subsets only, `font-display: swap`, and a preload for the one file the
// first screen needs most, Newsreader roman latin (h1 and body text).
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import newsreaderLatinExt from "@fontsource-variable/newsreader/files/newsreader-latin-ext-opsz-normal.woff2?url";
import newsreaderItalicLatin from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url";
import newsreaderItalicLatinExt from "@fontsource-variable/newsreader/files/newsreader-latin-ext-opsz-italic.woff2?url";
import instrumentLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import instrumentLatinExt from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wght-normal.woff2?url";

// unicode-range values copied from the packages' own CSS
const LATIN =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const LATIN_EXT =
  "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF";

const faces = [
  { family: "Newsreader Variable", style: "normal", weight: "200 800", url: newsreaderLatin, range: LATIN },
  { family: "Newsreader Variable", style: "normal", weight: "200 800", url: newsreaderLatinExt, range: LATIN_EXT },
  { family: "Newsreader Variable", style: "italic", weight: "200 800", url: newsreaderItalicLatin, range: LATIN },
  { family: "Newsreader Variable", style: "italic", weight: "200 800", url: newsreaderItalicLatinExt, range: LATIN_EXT },
  { family: "Instrument Sans Variable", style: "normal", weight: "400 700", url: instrumentLatin, range: LATIN },
  { family: "Instrument Sans Variable", style: "normal", weight: "400 700", url: instrumentLatinExt, range: LATIN_EXT },
];

const css = faces
  .map(
    (f) =>
      `@font-face{font-family:"${f.family}";font-style:${f.style};font-weight:${f.weight};font-display:swap;src:url(${f.url}) format("woff2");unicode-range:${f.range}}`
  )
  .join("");
---

<link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
<Fragment set:html={`<style>${css}</style>`} />
