---
// "Built with A, B and C." under a project's text
import { listOf } from "../lib/projects";

interface Props {
  stack: string[];
}
---

<p class="built">Built with {listOf(Astro.props.stack)}.</p>

<style>
  .built {
    margin: 0 0 18px;
    font: 400 0.9rem/1.6 var(--sans);
    color: var(--muted);
  }
</style>
