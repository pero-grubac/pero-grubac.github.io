---
// The toast: an ink pill at the bottom centre that announces short
// confirmations ("Email copied"). Shown with toast() from scripts/toast.ts.
---

<div class="toast" id="toast" role="status"></div>

<style>
  .toast {
    position: fixed;
    left: 50%;
    bottom: var(--s-5);
    z-index: 50;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font: 500 0.85rem var(--sans);
    opacity: 0;
    transform: translate(-50%, 16px);
    transition:
      opacity var(--t-toast),
      transform var(--t-toast);
    pointer-events: none;
  }

  .toast[data-show] {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
