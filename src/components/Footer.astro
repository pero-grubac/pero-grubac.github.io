---
// Colophon footer. One theme, so no `t` hint;
// the `/` hint only on pages that have a find field.
interface Props {
  findHint?: string | undefined;
}

const { findHint } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>© {year} Pero Grubač. Set in Newsreader and Instrument Sans.</p>
    <p>
      Press {findHint && <Fragment><kbd>/</kbd> to {findHint}, </Fragment>}<kbd><span data-mod>Ctrl</span> K</kbd> for
      commands.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
    padding: 22px 0 34px;
    font: 400 0.85rem var(--sans);
    color: var(--muted);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
  }

  p {
    margin: 0;
  }
</style>
