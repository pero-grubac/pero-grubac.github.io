---
// Colophon footer (REDESIGN.md 6.6 and 7.7). One theme, so no `t` hint.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>© {year} Pero Grubač. Set in Newsreader and Instrument Sans.</p>
    <p>Press <kbd>/</kbd> to search the index, <kbd><span data-mod>Ctrl</span> K</kbd> for commands.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
    padding: 22px 0 34px;
    font: 400 0.85rem var(--sans);
    color: var(--muted);
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
  }

  p {
    margin: 0;
  }
</style>
