---
// Every meta tag a page needs (REDESIGN.md 10.1): title, description,
// canonical, Open Graph, Twitter card and JSON-LD. Pages pass their values
// through the Base layout; none writes meta tags by hand. One light theme,
// so a single theme-color.
import { absolute } from "../lib/seo";
import { site } from "../lib/site";

interface Props {
  /** "{Page} | Pero Grubač", at most 60 characters */
  title: string;
  /** 140–160 characters, what the visitor will find on the page */
  description: string;
  /** Root-relative path of a 1200×630 social image */
  image?: string | undefined;
  imageAlt?: string | undefined;
  type?: "website" | "article" | undefined;
  /** Keep the page out of search results (the 404); it then has no canonical URL */
  noindex?: boolean | undefined;
  /** Structured data, rendered as application/ld+json */
  jsonLd?: Record<string, unknown> | undefined;
}

const {
  title,
  description,
  image = "/assets/og-card.png",
  imageAlt = "Pero Grubač, backend developer: distributed systems, REST APIs and microservices with Java, C#, Python, Spring Boot, .NET and FastAPI.",
  type = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const url = absolute(Astro.url.pathname);
const imageUrl = absolute(image);
// TODO(owner): to verify the site in Google Search Console with a meta tag,
// set GOOGLE_SITE_VERIFICATION (the tag's content value) as a repository
// variable; deploy.yml passes it to the build. Unset, no tag is rendered.
const verification = import.meta.env.GOOGLE_SITE_VERIFICATION;
// "</script>" inside a string would end the script element early
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#f4f0e6" />
{verification && <meta name="google-site-verification" content={verification} />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={url} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{ld && <script is:inline type="application/ld+json" set:html={ld} />}
