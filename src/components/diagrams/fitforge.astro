---
// FitForge, from the fit_forge README and code: lib/data/providers.dart
// (repositories and DAOs on DatabaseHelper), database_helper.dart (sqflite,
// schema version 6), settings_provider.dart (SharedPreferences),
// core/services/rest_alerts.dart (flutter_local_notifications) and
// backup_repository.dart (JSON backup through file_picker). The app has no
// network code; url_launcher only opens exercise videos outside it.
import Diagram from "../diagram/Diagram.astro";
import Node from "../diagram/Node.astro";
import Edge from "../diagram/Edge.astro";
import Group from "../diagram/Group.astro";
---

<Diagram
  width={920}
  height={520}
  label="Architecture of FitForge"
  caption="Everything stays on the phone; the app has no network code. Screens call Riverpod notifiers, which reach SQLite through repositories and DAOs. Settings live in SharedPreferences, the rest timer posts Android notifications, and a backup is the whole database as one JSON file, which a restore replaces in a single transaction."
>
  <Group x={20} y={40} w={590} h={360} name="FitForge · Flutter" />

  <Edge points={[[140, 136], [140, 200]]} label="watch, call" at={[148, 172]} anchor="start" />
  <Edge points={[[140, 256], [140, 320]]} label="providers.dart" at={[148, 292]} anchor="start" />
  <Edge points={[[230, 348], [330, 348]]} />
  <Edge points={[[530, 348], [690, 348]]} label="sqflite" at={[650, 340]} />
  <Edge points={[[230, 214], [300, 214], [300, 107], [690, 107]]} label="settings, setup done" at={[560, 99]} />
  <Edge points={[[230, 240], [330, 240]]} label="rest timer" at={[280, 258]} />
  <Edge points={[[530, 228], [690, 228]]} label="countdown, rest done" at={[610, 220]} />
  <Edge points={[[100, 376], [100, 468], [330, 468]]} label="exercise photos" at={[215, 460]} />
  <Edge points={[[200, 376], [200, 420], [790, 420], [790, 440]]} both label="back up, restore" at={[450, 412]} />

  <Node x={50} y={80} w={180} name="Screens" note="GoRouter · fl_chart charts" />
  <Node x={50} y={200} w={180} name="Riverpod" note="notifiers, FutureProviders" />
  <Node x={50} y={320} w={180} name="Repositories" note="plans, logs, exercises, backup" />
  <Node x={330} y={200} w={200} name="RestAlerts" note="flutter_local_notifications" />
  <Node x={330} y={320} w={200} name="DAOs" note="DatabaseHelper · migrations" />
  <Node x={690} y={76} w={200} h={62} kind="store" name="SharedPreferences" note="settings and flags" />
  <Node x={690} y={200} w={200} kind="external" name="Android notifications" note="live countdown, alert" />
  <Node x={690} y={316} w={200} h={62} kind="store" name="SQLite" note="fitforge.db · 8 tables · v6" />
  <Node x={330} y={440} w={200} kind="file" name="Exercise images" note="app documents folder" />
  <Node x={690} y={440} w={200} kind="file" name="JSON backup" note="file_picker · schema 3–6" />
</Diagram>
