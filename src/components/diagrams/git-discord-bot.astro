---
// GitHub Discord Bot, from the git-discord-bot README (architecture, the
// /add and webhook sequences, deployment) and its code: main.py (owner
// check), cogs/ (commands and the Flask webhook thread),
// services/issue_actions.py, core/echo.py and render.yaml.
import Diagram from "../diagram/Diagram.astro";
import Node from "../diagram/Node.astro";
import Edge from "../diagram/Edge.astro";
import Group from "../diagram/Group.astro";
import Actor from "../diagram/Actor.astro";
---

<Diagram
  width={1090}
  height={430}
  label="Architecture of the GitHub Discord Bot"
  caption="One Python process on Render runs the Discord bot on the asyncio event loop and a Flask server on its own thread for GitHub's webhook. Every command, button and menu passes the owner check first. Issue actions change GitHub first and the database second, and remember each change for five minutes, so the webhook GitHub sends back for it updates Supabase but posts nothing. Calls to GitHub and Supabase run in threads, so the bot keeps answering Discord while it waits."
>
  <Group x={230} y={40} w={640} h={340} name="Render · one Python process" />

  <Edge points={[[160, 118], [250, 118]]} />
  <Edge points={[[430, 118], [470, 118]]} />
  <Edge points={[[560, 146], [560, 200]]} label="add, close" at={[568, 176]} anchor="start" />
  <Edge points={[[650, 104], [910, 104]]} label="REST · to_thread" at={[780, 96]} />
  <Edge points={[[650, 214], [670, 214], [670, 124], [910, 124]]} />
  <Edge points={[[990, 146], [990, 228], [850, 228]]} label="signed webhook" at={[920, 220]} />
  <Edge points={[[770, 256], [770, 331], [910, 331]]} label="save issue" at={[840, 323]} />
  <Edge points={[[560, 256], [560, 350], [910, 350]]} label="issues, repositories" at={[735, 342]} />
  <Edge points={[[710, 256], [710, 400], [105, 400], [105, 376]]} label="cards, through the bot's event loop" at={[400, 392]} />
  <Edge points={[[250, 228], [105, 228], [105, 320]]} label="report, reminder" at={[178, 220]} />

  <Actor x={90} y={114} name="You" note="commands, buttons, forms" />
  <Node x={250} y={90} w={180} name="Owner check" note="commands, buttons, menus" />
  <Node x={470} y={90} w={180} name="Cogs and views" note="Close, menus, pagers, form" />
  <Node x={250} y={200} w={180} name="Scheduled tasks" note="monthly report, reminder" />
  <Node x={470} y={200} w={180} name="Issue actions" note="GitHub first, then the DB" />
  <Node x={690} y={200} w={160} name="Flask thread" note="/webhook · /health" />
  <Node x={20} y={320} w={170} kind="external" name="Discord channels" note="notifications, reports" />
  <Node x={910} y={90} w={160} kind="external" name="GitHub API" note="issues, commits, search" />
  <Node x={910} y={300} w={160} h={62} kind="store" name="Supabase" note="PostgreSQL" />
</Diagram>
