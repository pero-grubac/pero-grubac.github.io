---
// Stands in for a screenshot when a project has none (8.4): its slash
// commands as a small code-style block.
import type { Project } from "../lib/projects";

interface Props {
  commands: NonNullable<Project["commands"]>;
}
---

<ul class="cmds" aria-label="Slash commands">
  {
    Astro.props.commands.map((c) => (
      <li>
        <code>{c.cmd}</code> {c.text}
      </li>
    ))
  }
</ul>

<style>
  .cmds {
    list-style: none;
    margin: 0 0 16px;
    padding: 14px 16px;
    background: var(--card);
    border: var(--hairline);
    font: 0.92rem/1.7 var(--sans);
    color: var(--ink-soft);
  }

  code {
    font: 600 0.85rem var(--mono);
    color: var(--accent);
  }
</style>
