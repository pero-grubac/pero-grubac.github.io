---
// The home page (REDESIGN.md section 7): hero, about, systems, the index
// of every other project, the apps teaser and contact.
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Systems from "../components/home/Systems.astro";
import ProjectIndex from "../components/home/ProjectIndex.astro";
import AppsTeaser from "../components/home/AppsTeaser.astro";
import Contact from "../components/home/Contact.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects();
const systems = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
const apps = projects.filter((p) => p.kind === "live");
---

<Base
  title="Pero Grubač | Backend Developer"
  description="Pero Grubač — backend developer building distributed systems, REST APIs and microservices with Java, C# and Python. Spring Boot, ASP.NET and FastAPI project portfolio."
>
  <div class="wrap home">
    <Hero systems={systems} indexCount={others.length} liveCount={apps.length} />
    <About projects={projects} />
    <Systems systems={systems} />
    <ProjectIndex systems={systems} projects={others} />
    <AppsTeaser apps={apps} />
    <Contact />
  </div>
</Base>

<style>
  .home > :global(section:not(:first-child)) {
    padding: var(--section-pad) 0;
  }
</style>
