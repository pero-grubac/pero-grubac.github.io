---
// Phase 1: the empty layout with the hero's h1 and standfirst, enough to
// compare against design-explorations/direction-b/. Phase 3 builds the page.
import Base from "../layouts/Base.astro";
---

<Base
  title="Pero Grubač | Backend Developer"
  description="Pero Grubač — backend developer building distributed systems, REST APIs and microservices with Java, C# and Python. Spring Boot, ASP.NET and FastAPI project portfolio."
>
  <section class="hero wrap">
    <p class="dateline">Banja Luka, Bosnia and Herzegovina · Java, C# and Python</p>
    <h1>Pero Grubač</h1>
    <p class="standfirst">
      Backend developer in Banja Luka. I build services that talk to each other over queues, sockets and REST.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(40px, 8vw, 110px);
    padding-bottom: clamp(40px, 6vw, 80px);
  }

  .dateline {
    font: 500 0.85rem var(--sans);
    color: var(--muted);
    margin: 0 0 18px;
  }

  .standfirst {
    font-style: italic;
    font-weight: 300;
    font-size: var(--fs-standfirst);
    line-height: 1.35;
    max-width: 30ch;
    margin: 28px 0 0;
    color: var(--ink-soft);
  }
</style>
