---
// Not found (REDESIGN.md 6.8, 8.5). GitHub Pages serves this file for any
// missing path, at that path, so every URL on it is root-relative.
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | Pero Grubač"
  description="This page doesn't exist on Pero Grubač's portfolio. Go back to the home page, or open one of the browser apps."
  noindex
>
  <section class="wrap lost" aria-labelledby="lost-h">
    <h1 id="lost-h">This page doesn't exist.</h1>
    <p class="line">Check the address for a typo, or start again from one of these pages.</p>
    <ul>
      <li><a class="lnk lnk-strong" href="/">Home<span aria-hidden="true"> →</span></a></li>
      <li><a class="lnk" href="/apps/">Browser apps<span aria-hidden="true"> →</span></a></li>
    </ul>
  </section>
</Base>

<style>
  .lost {
    padding-top: clamp(48px, 10vw, 140px);
    padding-bottom: var(--section-pad);
  }

  h1 {
    max-width: 12ch;
  }

  .line {
    max-width: 40ch;
    margin: 28px 0 30px;
    font-size: var(--fs-standfirst);
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    list-style: none;
    margin: 0;
    padding: 0;
    font: 600 0.95rem var(--sans);
  }
</style>
