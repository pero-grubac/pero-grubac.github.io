---
// /apps/ (REDESIGN.md 6.8, 8.1): every live app as a figure with its
// screenshot, summary, stack and links, and the same find field as the
// home index. A typed query matches any part of a title, summary or
// technology, as on the home page.
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import FindField from "../components/FindField.astro";
import NoMatch from "../components/NoMatch.astro";
import BuiltWith from "../components/BuiltWith.astro";
import ProjectLinks from "../components/ProjectLinks.astro";
import { getProjects, haystack, listOf } from "../lib/projects";

const apps = (await getProjects()).filter((p) => p.kind === "live");
const named = apps.slice(0, 3).map((p) => p.title);
const description = `Browser apps by Pero Grubač that you can open right now: ${listOf([...named, `${apps.length - named.length} more`])}, from developer tools to games and score tables.`;
---

<Base title={`${apps.length} browser apps you can open right now | Pero Grubač`} description={description} findHint="find an app">
  <section class="wrap page" aria-labelledby="apps-h">
    <div class="head">
      <h1 id="apps-h" class="page-title">Browser apps</h1>
      <p class="intro">
        {apps.length} apps that run in your browser: developer tools, games, score tables and a few small utilities. Each
        one opens in a new tab.
      </p>
    </div>

    <div class="find" role="search">
      <FindField id="find-app" label="Find an app" />
    </div>
    <p class="sr-only" aria-live="polite" data-status></p>

    <ul class="gallery">
      {
        apps.map((p, i) => (
          <li data-item data-hay={haystack(p)}>
            {/* Mouse and touch can open the app from its screenshot; keyboards use "Open" below */}
            <a class="shot" href={p.links.live} target="_blank" rel="noopener" tabindex="-1">
              <Picture
                src={p.image!}
                alt={p.imageAlt!}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[400, 800]}
                sizes="(min-width: 1280px) 373px, (min-width: 720px) 45vw, 92vw"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding="async"
              />
            </a>
            <h2 class="title">{p.title}</h2>
            <p class="sum">{p.summary}</p>
            <BuiltWith stack={p.stack} />
            <ProjectLinks project={p} caseStudy={p.caseStudy} short />
          </li>
        ))
      }
    </ul>
    <NoMatch noun="app" />
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: var(--section-pad);
  }

  .head {
    display: grid;
    gap: var(--s-4) var(--s-7);
    padding-top: 18px;
    border-top: var(--rule-double);
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  /* the title keeps one line; the intro takes what's left */
  @media (min-width: 900px) {
    .head {
      grid-template-columns: max-content minmax(0, 1fr);
      align-items: end;
    }
  }

  .intro {
    max-width: 46ch;
    margin: 0;
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .find {
    max-width: 720px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--s-7) var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .shot {
    display: block;
    margin-bottom: 14px;
  }

  .shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top left;
    border: var(--hairline);
  }

  .title {
    margin: 0 0 var(--s-1);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-variation-settings: normal;
  }

  li:has(.shot:hover) .title {
    color: var(--accent);
  }

  .sum {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-find]")!;
  const items = [...document.querySelectorAll<HTMLElement>("[data-item]")];
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;

  function apply() {
    const query = input.value.trim();
    const needle = query.toLowerCase();
    let shown = 0;
    for (const item of items) {
      item.hidden = !item.dataset.hay!.includes(needle);
      if (!item.hidden) shown++;
    }
    empty.hidden = shown > 0;
    empty.querySelector("[data-empty-q]")!.textContent = query;
    const noun = shown === 1 ? "app" : "apps";
    status.textContent = `${shown} ${noun}` + (query ? ` ${shown === 1 ? "matches" : "match"} “${query}”` : "");
  }

  input.addEventListener("input", apply);
  empty.querySelector("[data-clear]")!.addEventListener("click", () => {
    input.value = "";
    apply();
    input.focus();
  });
  // a query the browser restored on back/forward
  if (input.value) apply();
</script>
