---
// Case study (REDESIGN.md 6.8, 8.2), one page per project with
// caseStudy: true: breadcrumb, title and summary with the app's own link
// (Open app, Download APK), the architecture line and diagram (systems),
// the demo video, screenshot or command list, then the body as a reading
// column beside a sticky margin ("On this page", stack, code), and the
// previous and next project of the same kind.
// A project's diagram is components/diagrams/<slug>.astro, if there is one.
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Flow from "../../components/Flow.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import DemoFigure from "../../components/DemoFigure.astro";
import Commands from "../../components/Commands.astro";
import { KIND_NOUNS, listOf, parentOf, type Project } from "../../lib/projects";
import { caseStudyJsonLd } from "../../lib/seo";

const diagrams = import.meta.glob<{ default: AstroComponentFactory }>("../../components/diagrams/*.astro", { eager: true });

export async function getStaticPaths() {
  const entries = (await getCollection("projects", (e) => e.data.caseStudy)).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry) => {
    const sameKind = entries.filter((e) => e.data.kind === entry.data.kind);
    const i = sameKind.indexOf(entry);
    return {
      params: { slug: entry.data.slug },
      props: { entry, prev: sameKind[i - 1]?.data, next: sameKind[i + 1]?.data },
    };
  });
}

interface Props {
  entry: CollectionEntry<"projects">;
  prev?: Project | undefined;
  next?: Project | undefined;
}

const { entry, prev, next } = Astro.props;
const p = entry.data;
const { Content, headings } = await render(entry);
const written = Boolean(entry.body?.trim());
const sections = written ? headings.filter((h) => h.depth === 2) : [];
const diagram = diagrams[`../../components/diagrams/${p.slug}.astro`] as { default: AstroComponentFactory } | undefined;
const Diagram = diagram?.default;
const [one, many] = KIND_NOUNS[p.kind];

const parent = parentOf(p);
// What the social image (/projects/<slug>/og.png) shows
const imageAlt = `${p.title}, a ${one} by Pero Grubač. ${p.flow ? `Architecture: ${p.flow}` : p.summary}`;
---

<Base
  title={`${p.title} | Pero Grubač`}
  description={p.metaDescription!}
  type="article"
  image={`/projects/${p.slug}/og.png`}
  imageAlt={imageAlt}
  jsonLd={caseStudyJsonLd(p)}
>
  <article class="wrap case" aria-labelledby="case-h">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={parent.href}>{parent.label}</a></li>
        <li><span aria-current="page">{p.title}</span></li>
      </ol>
    </nav>

    <header class="head">
      <h1 id="case-h" class="page-title">{p.title}</h1>
      <p class="dek">{p.summary}</p>
      {
        (p.links.live || p.links.apk) && (
          <div class="primary">
            <ProjectLinks project={p} repos={false} />
          </div>
        )
      }
    </header>

    {
      p.flow && (
        <div class="flowline">
          <Flow flow={p.flow} />
        </div>
      )
    }

    {
      Diagram && (
        <div class="architecture">
          <Diagram />
        </div>
      )
    }

    {
      p.video ? (
        <DemoFigure image={p.image!} alt={p.imageAlt!} title={p.title} video={p.video} priority={!Diagram} />
      ) : p.image ? (
        <figure class="shot">
          <Picture
            src={p.image}
            alt={p.imageAlt!}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1280px) 1184px, 92vw"
            loading={Diagram ? "lazy" : "eager"}
            fetchpriority={Diagram ? undefined : "high"}
            decoding="async"
          />
        </figure>
      ) : (
        p.commands && (
          <div class="shot">
            <Commands commands={p.commands} />
          </div>
        )
      )
    }

    <div class="reading">
      {/* The margin comes first, so on phones it sits above the body */}
      <aside class="margin" aria-label="About this project">
        {
          sections.length > 0 && (
            <nav class="part" aria-labelledby="toc-h">
              <p class="label" id="toc-h">
                On this page
              </p>
              <ol class="toc">
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="part">
          <p class="label">Built with</p>
          <p class="stack">{listOf(p.stack)}</p>
        </div>
        <div class="part">
          <p class="label">Code</p>
          <ProjectLinks project={p} actions={false} />
        </div>
      </aside>

      <div class="body">
        {
          written ? (
            <Content />
          ) : (
            <Fragment>
              <p>{p.description}</p>
              {p.highlights.length > 0 && (
                <ul>
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              <p class="note">Case study in progress.</p>
            </Fragment>
          )
        }
      </div>
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label={`Other ${many}`}>
          {prev && (
            <a class="prev" href={`/projects/${prev.slug}/`} rel="prev">
              <span class="dir">
                <span aria-hidden="true">← </span>Previous {one}
              </span>{" "}
              <span class="name">{prev.title}</span>
            </a>
          )}
          {next && (
            <a class="next" href={`/projects/${next.slug}/`} rel="next">
              <span class="dir">
                Next {one}
                <span aria-hidden="true"> →</span>
              </span>{" "}
              <span class="name">{next.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .case {
    padding-top: clamp(28px, 4vw, 48px);
    padding-bottom: var(--section-pad);
  }

  /* ---------- breadcrumb ---------- */
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    font: 500 0.85rem var(--sans);
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: "/" / "";
    margin-right: var(--s-2);
    color: var(--rule);
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration-color: var(--rule);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  /* ---------- head ---------- */
  .head {
    padding-top: 18px;
    border-top: var(--rule-double);
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .dek {
    max-width: 40ch;
    margin: 20px 0 0;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  /* the app's own link, in accent: the one thing to act on at the top */
  .primary {
    margin-top: 22px;
  }

  .primary :global(.lnk) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .flowline {
    max-width: 68ch;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .architecture {
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  /* a screenshot at its own size, never stretched past it */
  .shot {
    margin: 0;
  }

  .shot :global(img) {
    max-width: 100%;
    border: var(--hairline);
  }

  .shot :global(.cmds) {
    max-width: 520px;
  }

  /* ---------- the reading column and its margin ---------- */
  .reading {
    display: grid;
    gap: var(--s-6);
    margin-top: clamp(36px, 5vw, 56px);
  }

  @media (min-width: 1040px) {
    .reading {
      grid-template-columns: minmax(0, 68ch) minmax(220px, 290px);
      justify-content: space-between;
      align-items: start;
    }

    .body {
      grid-column: 1;
      grid-row: 1;
    }

    .margin {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 92px;
      padding-left: var(--s-5);
      border-left: var(--hairline);
    }
  }

  .margin {
    font: 400 0.9rem/1.5 var(--sans);
    color: var(--ink-soft);
  }

  @media (max-width: 1039px) {
    .margin {
      padding-bottom: var(--s-5);
      border-bottom: var(--hairline);
    }
  }

  .part + .part {
    margin-top: var(--s-5);
  }

  .label {
    margin: 0 0 var(--s-2);
    font-weight: 600;
    font-size: var(--fs-caption);
    color: var(--muted);
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li + li {
    margin-top: 6px;
  }

  .toc a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .toc a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .stack {
    margin: 0;
  }

  .margin :global(.links) {
    flex-direction: column;
    gap: 6px;
    font-size: 0.9rem;
  }

  /* ---------- body: the reading column, aligned with the title ---------- */
  .body {
    max-width: 68ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--ink);
  }

  .body > :global(:first-child) {
    margin-top: 0;
  }

  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1em;
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.2em;
  }

  .body :global(h2) {
    margin: 1.6em 0 0.5em;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .body :global(h3) {
    margin: 1.4em 0 0.4em;
    font-size: 1.3rem;
    font-weight: 500;
  }

  .body :global(code) {
    font: 0.9em var(--mono);
  }

  /* links read as ink; the accent only marks the hover (6.1) */
  .body :global(a) {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .body :global(a:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .body :global(strong) {
    font-weight: 600;
  }

  .body :global(li) {
    margin-bottom: 0.4em;
  }

  /* en dashes, as in the index details, in --muted rather than accent */
  .body :global(ul) {
    list-style: "– ";
  }

  .body :global(ul > li::marker) {
    color: var(--muted);
  }

  .note {
    padding-top: var(--s-3);
    border-top: var(--hairline);
    font: 500 0.85rem var(--sans);
    color: var(--muted);
  }

  /* ---------- previous / next of the same kind ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
    margin-top: var(--section-pad);
    padding-top: 18px;
    border-top: var(--rule-double);
  }

  .pager a {
    display: grid;
    gap: var(--s-1);
    text-decoration: none;
  }

  .next {
    grid-column: 2;
    text-align: right;
  }

  .dir {
    font: 600 0.85rem var(--sans);
    color: var(--muted);
  }

  .name {
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .pager a:hover .name {
    color: var(--accent);
  }
</style>
